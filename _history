number,\n        y0: number,\n        a: number,\n        b: number,\n        c: number\n    ): Ent {\n"]]},{"start1":2046,"length1":104,"diffs":[[1,"\n        e.t = t\n        e.s = s\n        e.x0 = x0\n        e.y0 = y0\n        e.a = a\n        e.b = b\n        e.c = c\n        e.ph = randint(0, 628) / 100\n\n"]]},{"start1":2245,"length1":0,"diffs":[[1,"\n"]]},{"start1":2358,"length1":53,"diffs":[[1,"\n        if (ghost) {\n            s.setFlag(SpriteFlag.Ghost, true)\n        }\n\n"]]},{"start1":2460,"length1":77,"diffs":[[1,"\n    // Manual box-overlap test\n    export function touch(a: Sprite, b: Sprite): boolean {\n        return a.left + 2 < b.right - 1 &&\n            a.right - 2 > b.left + 1 &&\n            a.top + 1 < b.bottom - 1 &&\n            a.bottom - 1 > b.top + 1\n    }\n\n    export function popup(\n        text: string,\n        x: number,\n        y: number,\n        col: number\n    ) {\n"]]},{"start1":2889,"length1":91,"diffs":[[1,"\n        im.print(text, 1, 1, C.Black, image.font5)\n        im.print(text, 0, 0, col, image.font5)\n\n"]]},{"start1":3026,"length1":74,"diffs":[[1,""]]},{"start1":3027,"length1":4028,"diffs":[[1,"        s.setPosition(x, y)\n        s.vy = -24\n        s.z = 20\n        s.lifespan = 800\n"]]},{"start1":3123,"length1":8010,"diffs":[[1,"    // =================================================================\n    // IMPORTANT:\n    // Keep your original spawnAll() and remaining update() branches.\n    // The supplied source ended inside the S.Drip branch.\n    // =================================================================\n\n    // Moving-platform calculation:\n    // const dist = Math.abs(e.b - e.a)\n\n    // Spring activation:\n    export function updateSpring(e: Ent, hero: Sprite) {\n"]]},{"start1":3599,"length1":432,"diffs":[[1,"\n        if (!s) return\n\n        if (e.tm > 0) {\n            e.tm -= 16\n\n            if (e.tm <= 0) {\n                s.setImage(Art.spring[0])\n"]]},{"start1":3767,"length1":68,"diffs":[[1,""]]},{"start1":3768,"length1":847,"diffs":[[1,"        if (\n            e.tm <= 0 &&\n            hero.vy >= 0 &&\n            hero.right > s.left + 2 &&\n            hero.left < s.right - 2 &&\n            hero.bottom >= s.top - 1 &&\n            hero.bottom <= s.bottom + 2\n        ) {\n            Player.launch(-268)\n            s.setImage(Art.spring[1])\n            e.tm = 220\n            music.jumpUp.play()\n"]]},{"start1":4139,"length1":3188,"diffs":[[1,""]]},{"start1":4145,"length1":642,"diffs":[[1,"}"]]}]}]},{"timestamp":1795670521316,"editorVersion":"4.1.32","changes":[{"type":"edited","filename":"entities.ts","patch":[{"start1":20013,"length1":1,"diffs":[[1,"}\n"]]}]}]},{"timestamp":1795670526989,"editorVersion":"4.1.32","changes":[{"type":"edited","filename":"entities.ts","patch":[{"start1":13002,"length1":112,"diffs":[[1,"                if (hero.overlapsWith(s)) {\n"]]},{"start1":13972,"length1":160,"diffs":[[1,"                if (hero.overlapsWith(s)) { Player.hurt(s.x); shatter(e, false); continue }\n"]]}]}]},{"timestamp":1795671862181,"editorVersion":"4.1.32","changes":[{"type":"edited","filename":"pxt.json","patch":[{"start1":302,"length1":44,"diffs":[[1,""]]}]},{"type":"added","filename":"test.ts","value":"// tests go here; this will not be compiled when this package is used as an extension.\n"},{"type":"added","filename":"main.blocks","value":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <variables></variables>\n  <block type=\"pxt-on-start\" x=\"0\" y=\"0\"></block>\n</xml>"}]}],"snapshots":[{"timestamp":1795653319695,"editorVersion":"4.1.32","text":{"main.ts":"// =====================================================================\n//  ChemLab: The Chemical Crisis  —  main.ts\n//  Game flow: title -> story -> briefing -> level -> results -> ...\n//  Score, stats, chem-lock doors, saving, achievements.\n//  This is the ONLY file with top-level code (the last line).\n// =====================================================================\nnamespace Game {\n    export const PLAY = 1\n    export const PAUSED = 2\n    export const MENU = 0\n    export let state: number\n    export let level: number\n    export let score: number\n    export let stats: number[]          // 0 wrong, 1 hits, 2 flasks, 3 rare, 4 logs, 5 stomps\n    export let totalFlasks: number\n    export let unlocked: number\n    export let best: number[]\n    export let stars: number[]\n    export let ach: number\n    let doorsOpened: boolean[]\n    let used: number[]\n    let doorCool: number\n    let lastT: number\n    let startT: number\n    let wave: number\n\n    // ---------------- boot ----------------\n    export function boot() {\n        state = MENU; level = 0; score = 0; stats = [0, 0, 0, 0, 0, 0]; totalFlasks = 0\n        doorsOpened = []; used = []; doorCool = 0; lastT = game.runtime(); startT = 0; wave = 0\n        load()\n        Art.initSprites()\n        Art.setTheme(0)\n        Levels.build(0)\n        UI.initRenderers()\n        game.onUpdate(update)\n        game.onUpdateInterval(140, () => { if (Art.tiles != null) { wave++; Art.animateTiles(wave) } })\n        scene.setBackgroundColor(C.Black)\n        showTitle()\n    }\n\n    // ---------------- save data ----------------\n    function load() {\n        unlocked = settings.exists(\"cl_unlocked\") ? settings.readNumber(\"cl_unlocked\") : 0\n        ach = settings.exists(\"cl_ach\") ? settings.readNumber(\"cl_ach\") : 0\n        best = []; stars = []\n        for (let i = 0; i < 5; i++) {\n            best.push(settings.exists(\"cl_best\" + i) ? settings.readNumber(\"cl_best\" + i) : 0)\n            stars.push(settings.exists(\"cl_stars\" + i) ? settings.readNumber(\"cl_stars\" + i) : 0)\n        }\n    }\n    function save() {\n        settings.writeNumber(\"cl_unlocked\", unlocked)\n        settings.writeNumber(\"cl_ach\", ach)\n        for (let i = 0; i < 5; i++) { settings.writeNumber(\"cl_best\" + i, best[i]); settings.writeNumber(\"cl_stars\" + i, stars[i]) }\n    }\n    export function unlockAll() { unlocked = 4; save() }\n    export function unlock(i: number) {\n        if (((ach >> i) & 1) != 0) return\n        ach = ach | (1 << i); save()\n        UI.toast(\"TROPHY: \" + Data.achName(i))\n    }\n    export function achCount(): number { let n = 0; for (let i = 0; i < 6; i++) if (((ach >> i) & 1) != 0) n++; return n }\n    export function totalBest(): number { let n = 0; for (let i = 0; i < 5; i++) n += best[i]; return n }\n    export function totalStars(): number { let n = 0; for (let i = 0; i < 5; i++) n += stars[i]; return n }\n\n    // ---------------- menus ----------------\n    function showTitle() {\n        state = MENU\n        Art.setTheme(0)\n        UI.title((choice: number) => {\n            if (choice == 0) UI.dialog(Data.intro(), () => showBrief(0))\n            else if (choice == 1) showSelect()\n            else UI.dialog([\"\", \"MOVE: LEFT / RIGHT.  JUMP: A or UP (hold to jump higher). DROP DOWN: DOWN + A on a platform.\",\n                \"\", \"Walk into a CHEM LOCK door to get a question. Right answers open it. Wrong answers explain why, then you try again.\",\n                \"\", \"Stomp slimes and drones. Avoid fumes, flames, drips, shards and liquids. Falling in costs a heart.\",\n                \"\", \"Collect flasks, 3 RARE ELEMENTS, med-kits and LAB LOGS. Safety showers are checkpoints. Reach the EXIT LIFT!\"], showTitle)\n        })\n    }\n    function showSelect() {\n        state = MENU\n        Art.setTheme(Math.min(unlocked, 4))\n        UI.select((lv: number) => showBrief(lv), showTitle)\n    }\n    function showBrief(lv: number) {\n        state = MENU\n        Art.setTheme(lv)\n        UI.brief(lv, () => startLevel(lv), showSelect)\n    }\n\n    // ---------------- level ----------------\n    export function levelSub(): string { return [\"CHEMICAL IDENTIFICATION\", \"THE pH CHALLENGE\", \"CHEMICAL REACTIONS\", \"SEPARATION MISSION\", \"LABORATORY RESCUE\"][level] }\n    export function startLevel(lv: number) {\n        level = lv\n        Art.setTheme(lv)\n        Levels.build(lv)\n        Ents.clear()\n        const W = Levels.w, H = Levels.Dim.H\n        const buf = control.createBuffer(4 + W * H)\n        buf.setNumber(NumberFormat.UInt16LE, 0, W)\n        buf.setNumber(NumberFormat.UInt16LE, 2, H)\n        const walls = image.create(W, H)\n        for (let r = 0; r < H; r++) for (let c = 0; c < W; c++) {\n            const v = Levels.get(c, r)\n            buf.setUint8(4 + c + r * W, v)\n            if (Art.isSolid(v)) walls.setPixel(c, r, 2)\n        }\n        tiles.setCurrentTilemap(tiles.createTilemap(buf, walls, Art.tiles, TileScale.Sixteen))\n        Ents.spawnAll()\n        Player.create(24, 11 * 16 - 12)\n        score = 0; stats = [0, 0, 0, 0, 0, 0]; used = []; doorCool = 0\n        doorsOpened = []; for (let i = 0; i < Levels.doorCols.length; i++) doorsOpened.push(false)\n        totalFlasks = 0; for (let i = 0; i < Levels.sk.length; i++) if (Levels.sk[i] == S.Flask) totalFlasks++\n        lastT = game.runtime(); startT = lastT\n        state = PLAY\n        UI.banner([\"STORAGE WING\", \"ACID BASIN\", \"REACTION HALL\", \"SEPARATION PLANT\", \"CORE REACTOR\"][lv])\n        UI.radio(\"HALDEN\", lv < 4 ? \"Open all 3 chem locks and reach the exit lift. Good luck!\" : \"Reach the Core and stop M.I.X. Stay in the light!\")\n    }\n    export function putTile(c: number, r: number, t: number) {\n        Levels.map[r * Levels.Dim.MaxW + c] = t\n        const loc = tiles.getTileLocation(c, r)\n        tiles.setTileAt(loc, Art.tiles[t])\n        tiles.setWallAt(loc, Art.isSolid(t))\n    }\n    export function doorOpen(i: number): boolean { return doorsOpened[i] }\n\n    function update() {\n        const t = game.runtime()\n        let dt = (t - lastT) / 1000\n        lastT = t\n        if (dt > 0.05) dt = 0.05\n        if (dt < 0) dt = 0\n        if (state != PLAY) return\n        UI.tick(dt)\n        Player.update(dt, t)\n        if (state != PLAY) return\n        Ents.update(dt, t)\n        if (state != PLAY) return\n        const hero = Player.hero\n        // chem-lock doors\n        if (doorCool > 0) doorCool -= dt * 1000\n        const ac = Math.idiv(hero.right + 2, 16)\n        const v1 = Levels.get(ac, Math.idiv(hero.y, 16)), v2 = Levels.get(ac, Math.idiv(hero.bottom - 2, 16))\n        const isDoor = (v: number) => v == Art.T.DoorTop || v == Art.T.DoorMid || v == Art.T.DoorBot\n        if (doorCool <= 0 && (isDoor(v1) || isDoor(v2))) openDoorQuiz(ac)\n        // exit lift\n        if (Levels.get(Math.idiv(hero.x, 16), Math.idiv(hero.y, 16)) == Art.T.Exit) levelComplete()\n    }\n\n    // ---------------- questions ----------------\n    function topic(): string { return [\"IDENTIFY\", \"pH CHECK\", \"REACTIONS\", \"SEPARATION\", \"FINAL EXAM\"][level] }\n    function answered(correct: boolean, firstTry: boolean) {\n        if (correct) score += firstTry ? 150 : 100\n        else stats[0]++\n    }\n    function openDoorQuiz(col: number) {\n        const idx = Levels.doorCols.indexOf(col)\n        state = PAUSED\n        UI.quiz(\"CHEM LOCK \" + (idx + 1) + \"/3: \" + topic(), Data.bank(level), used, answered, (ok: boolean) => {\n            state = PLAY; lastT = game.runtime(); Player.ignoreA = true\n            if (ok) {\n                for (let r = 0; r < Levels.Dim.H; r++) {\n                    const v = Levels.get(col, r)\n                    if (v == Art.T.DoorTop || v == Art.T.DoorMid || v == Art.T.DoorBot) putTile(col, r, 0)\n                }\n                if (idx >= 0) doorsOpened[idx] = true\n                scene.cameraShake(3, 300); music.magicWand.play()\n                UI.toast(\"DOOR UNLOCKED!\")\n            } else {\n                doorCool = 1200\n                Player.hero.x -= 14\n            }\n        })\n    }\n    export function bossQuiz(c: Ent) {\n        state = PAUSED\n        UI.quiz(\"M.I.X. CONSOLE: OVERLOAD!\", Data.bank(4), used, answered, (ok: boolean) => {\n            state = PLAY; lastT = game.runtime(); Player.ignoreA = true\n            Ents.consoleResult(c, ok)\n        })\n    }\n\n    // ---------------- pickups & events ----------------\n    export function addScore(n: number, x: number, y: number) { score += n; Ents.popup(\"+\" + n, x, y, C.Yellow) }\n    export function gotFlask(x: number, y: number) { stats[2]++; score += 10; music.baDing.play() }\n    export function gotRare(x: number, y: number) {\n        stats[3]++; score += 250; music.magicWand.play()\n        Ents.popup(\"+250\", x, y - 8, C.LBlue)\n        UI.toast(\"RARE ELEMENT \" + stats[3] + \"/3: \" + Data.rareSymbols(level)[Math.min(2, stats[3] - 1)])\n    }\n    export function gotHeart(x: number, y: number) {\n        music.powerUp.play()\n        if (Player.hearts < Player.maxHearts) { Player.hearts++; Ents.popup(\"+1 HEART\", x, y - 6, C.Pink) }\n        else addScore(100, x, y - 6)\n    }\n    export function gotLog(n: number) {\n        stats[4]++; score += 50; music.sonar.play()\n        const lg = Data.log(level, n)\n        state = PAUSED\n        UI.dialog([lg[0].indexOf(\"M.I.X.\") >= 0 ? \"M.I.X.\" : \"\", lg[0] + \": \" + lg[1]], () => { state = PLAY; lastT = game.runtime(); Player.ignoreA = true })\n    }\n    export function stomped(x: number, y: number) { stats[5]++; addScore(50, x, y) }\n    export function toast(msg: string) { UI.toast(msg) }\n    export function radio(who: string, text: string) { UI.radio(who, text) }\n\n    // ---------------- end of level ----------------\n    export function gameOver() {\n        state = PAUSED\n        UI.gameOver(() => {\n            score = Math.max(0, score - 250)\n            Player.respawnAtCheckpoint()\n            state = PLAY; lastT = game.runtime(); Player.ignoreA = true\n        }, () => { Ents.clear(); showSelect() })\n    }\n    export function levelComplete() {\n        if (state != PLAY) return\n        state = MENU\n        music.powerUp.play()\n        const secs = Math.idiv(game.runtime() - startT, 1000)\n        const par = Data.parTime(level)\n        const timeBonus = Math.max(0, (par - secs) * 5)\n        const heartBonus = Player.hearts * 50\n        score += timeBonus + heartBonus\n        const st = 1 + (stats[2] * 10 >= totalFlasks * 8 ? 1 : 0) + (stats[0] == 0 ? 1 : 0)\n        if (level == 0) unlock(0)\n        if (stats[0] == 0) unlock(1)\n        if (stats[1] == 0) unlock(2)\n        if (stats[3] >= 3) unlock(3)\n        if (stats[4] >= 2) unlock(4)\n        if (score > best[level]) best[level] = score\n        if (st > stars[level]) stars[level] = st\n        unlocked = Math.max(unlocked, Math.min(4, level + 1))\n        save()\n        const mm = Math.idiv(secs, 60), ss = secs % 60\n        const rows = [\"TIME\", \"FLASKS\", \"RARE ELEMENTS\", \"LAB LOGS\", \"WRONG ANSWERS\", \"BONUS\", \"SCORE\"]\n        const vals = [mm + \":\" + (ss < 10 ? \"0\" : \"\") + ss, stats[2] + \"/\" + totalFlasks, stats[3] + \"/3\", stats[4] + \"/2\", \"\" + stats[0], \"+\" + (timeBonus + heartBonus), \"\" + score]\n        const lv = level\n        Ents.clear()\n        UI.results(lv < 4 ? \"SECTOR RESTORED!\" : \"M.I.X. DEFEATED!\", rows, vals, st, Data.debrief(lv), () => {\n            if (lv < 4) showBrief(lv + 1)\n            else UI.dialog(Data.ending(), () => UI.finale(showTitle))\n        }, showSelect)\n    }\n}\n\nGame.boot()\n","README.md":" ","assets.json":"","data.ts":"// =====================================================================\n//  ChemLab: The Chemical Crisis  —  data.ts\n//  Story text, question banks, achievements.  (No top-level code: safe\n//  in any file order. Everything is returned by functions.)\n// =====================================================================\nnamespace Data {\n    // Each question: [question, correct, wrong1, wrong2, wrong3, explanation]\n    export function bank(level: number): string[][] {\n        if (level == 0) return [\n            [\"A gas relights a glowing splint. Which gas is it?\", \"Oxygen\", \"Hydrogen\", \"Carbon dioxide\", \"Nitrogen\", \"Oxygen supports burning, so a glowing splint bursts back into flame. Hydrogen gives a squeaky pop and CO2 puts flames out.\"],\n            [\"A lit splint near a gas makes a squeaky POP. Which gas?\", \"Hydrogen\", \"Oxygen\", \"Chlorine\", \"Carbon dioxide\", \"Hydrogen burns very fast with oxygen in the air: 2H2 + O2 -> 2H2O. That quick burn makes the pop.\"],\n            [\"Bubbling a gas through limewater turns it milky. Which gas?\", \"Carbon dioxide\", \"Oxygen\", \"Hydrogen\", \"Ammonia\", \"CO2 reacts with limewater (calcium hydroxide) to make calcium carbonate, an insoluble white solid.\"],\n            [\"A salt gives a LILAC flame in a flame test. Which metal ion?\", \"Potassium K+\", \"Sodium Na+\", \"Copper Cu2+\", \"Calcium Ca2+\", \"Flame colours: K+ lilac, Na+ yellow-orange, Cu2+ blue-green, Ca2+ brick red, Li+ crimson.\"],\n            [\"A salt gives a BLUE-GREEN flame. Which ion is it?\", \"Copper Cu2+\", \"Lithium Li+\", \"Sodium Na+\", \"Potassium K+\", \"Copper(II) gives a blue-green flame. Lithium is crimson, sodium yellow-orange, potassium lilac.\"],\n            [\"A salt gives a BRICK-RED flame. Which ion is it?\", \"Calcium Ca2+\", \"Sodium Na+\", \"Copper Cu2+\", \"Potassium K+\", \"Calcium ions give an orange-red (brick red) flame. Lithium gives a deeper crimson.\"],\n            [\"A soft silvery metal is kept under oil and fizzes hard in water. What is it?\", \"Sodium\", \"Copper\", \"Iron\", \"Gold\", \"Group 1 metals like sodium react fast with water to make a hydroxide and hydrogen, so they are kept under oil.\"],\n            [\"A yellow-green choking gas bleaches damp litmus paper. What is it?\", \"Chlorine\", \"Oxygen\", \"Hydrogen\", \"Nitrogen\", \"Chlorine is a toxic yellow-green gas. It bleaches damp litmus paper white.\"],\n            [\"Blue crystals turn white when heated, and blue again with water. What are they?\", \"Hydrated CuSO4\", \"Sodium chloride\", \"Iron(III) oxide\", \"Calcium carbonate\", \"Heating removes the water of crystallisation, leaving white copper(II) sulfate. Adding water turns it blue: a test for water.\"],\n            [\"A liquid boils at exactly 100 C and freezes at 0 C. What is it?\", \"Pure water\", \"Ethanol\", \"Salt water\", \"Vinegar\", \"Pure substances have fixed melting and boiling points. Mixtures like salt water boil over a range, above 100 C.\"],\n            [\"A sharp-smelling gas turns damp red litmus BLUE. What is it?\", \"Ammonia\", \"Chlorine\", \"Hydrogen chloride\", \"Oxygen\", \"Ammonia (NH3) is the only common alkaline gas, so it turns damp red litmus blue.\"],\n            [\"Silver nitrate gives a WHITE precipitate. Which ion is present?\", \"Chloride Cl-\", \"Iodide I-\", \"Carbonate\", \"Sulfate\", \"Halide test: chloride gives a white precipitate (AgCl), bromide gives cream and iodide gives yellow.\"]\n        ]\n        if (level == 1) return [\n            [\"Lemon juice has a pH of about 2. It is...\", \"Strongly acidic\", \"Weakly acidic\", \"Neutral\", \"Alkaline\", \"Below pH 7 is acidic, and lower numbers are stronger. pH 1 to 3 is strongly acidic.\"],\n            [\"Pure water at 25 C has a pH of...\", \"7\", \"0\", \"1\", \"14\", \"Pure water is neutral: equal amounts of H+ and OH- ions give pH 7.\"],\n            [\"Universal indicator turns PURPLE. The solution is...\", \"Strongly alkaline\", \"Strongly acidic\", \"Neutral\", \"Weakly acidic\", \"Universal indicator: red = strong acid, orange/yellow = weak acid, green = neutral, blue = weak alkali, purple = strong alkali.\"],\n            [\"Which ion makes a solution acidic?\", \"H+ hydrogen ion\", \"OH- hydroxide ion\", \"Na+ sodium ion\", \"Cl- chloride ion\", \"Acids release H+ ions in water. Alkalis release OH- ions.\"],\n            [\"Compared with pH 5, a solution at pH 3 is...\", \"100x more acidic\", \"2x more acidic\", \"20x more acidic\", \"2x less acidic\", \"The pH scale is logarithmic: each step means 10 times more H+. Two steps is 10 x 10 = 100.\"],\n            [\"Acid + alkali gives...\", \"Salt + water\", \"Salt + hydrogen\", \"Only water\", \"Salt + CO2\", \"This is neutralisation: H+ + OH- -> H2O. For example HCl + NaOH -> NaCl + H2O.\"],\n            [\"Antacid tablets cure indigestion because they are...\", \"Bases\", \"Acids\", \"Neutral sugars\", \"Indicators\", \"Stomach acid is hydrochloric acid. Antacids contain bases that neutralise the extra acid.\"],\n            [\"Phenolphthalein turns PINK. The solution is...\", \"Alkaline\", \"Acidic\", \"Neutral\", \"Pure water\", \"Phenolphthalein is colourless in acids and neutral solutions, and pink in alkalis.\"],\n            [\"Blue litmus paper is dipped in vinegar. It turns...\", \"Red\", \"Stays blue\", \"Green\", \"Purple\", \"Vinegar contains ethanoic acid. Acids turn blue litmus red, and alkalis turn red litmus blue.\"],\n            [\"Bleach has a pH of about 13. It is...\", \"Strongly alkaline\", \"Strongly acidic\", \"Neutral\", \"Weakly acidic\", \"pH 13 is near the top of the scale, so bleach is strongly alkaline and corrosive. Never mix it with acids.\"],\n            [\"To raise the pH of acidic soil, farmers add...\", \"Lime\", \"Vinegar\", \"Sulfuric acid\", \"Lemon juice\", \"Lime (calcium hydroxide) is a base. It neutralises the acid in soil and raises the pH.\"]\n        ]\n        if (level == 2) return [\n            [\"Magnesium + hydrochloric acid gives...\", \"MgCl2 + hydrogen\", \"MgO + water\", \"MgCl2 + water\", \"Mg(OH)2 + chlorine\", \"Metal + acid -> salt + hydrogen. Mg + 2HCl -> MgCl2 + H2. The fizzing is hydrogen gas.\"],\n            [\"Complete combustion of methane (CH4) makes...\", \"CO2 + water\", \"CO + hydrogen\", \"Carbon + water\", \"Methanol\", \"CH4 + 2O2 -> CO2 + 2H2O. With too little oxygen you get toxic carbon monoxide and soot.\"],\n            [\"Calcium carbonate + hydrochloric acid gives...\", \"CaCl2 + H2O + CO2\", \"CaCl2 + hydrogen\", \"CaO + water\", \"Ca + Cl2 + O2\", \"Carbonate + acid -> salt + water + carbon dioxide. The fizzing is the CO2 escaping.\"],\n            [\"An iron nail sits in blue copper(II) sulfate. What happens?\", \"Copper coats nail\", \"Nothing happens\", \"Iron coats copper\", \"Hydrogen bubbles\", \"Displacement: iron is more reactive than copper, so Fe + CuSO4 -> FeSO4 + Cu, and the blue colour fades.\"],\n            [\"Hydrogen + oxygen gives...\", \"Water\", \"Hydrogen peroxide\", \"Ozone\", \"Carbon dioxide\", \"2H2 + O2 -> 2H2O. It releases lots of energy, which is why hydrogen is used as rocket fuel.\"],\n            [\"Strongly heating calcium carbonate gives...\", \"CaO + CO2\", \"Ca + CO2\", \"Ca(OH)2 + H2\", \"CaCl2 + water\", \"Thermal decomposition: CaCO3 -> CaO + CO2. One substance breaks down into two.\"],\n            [\"A test tube gets HOT during a reaction. The reaction is...\", \"Exothermic\", \"Endothermic\", \"Only physical\", \"Impossible to tell\", \"Exothermic reactions give out energy, so the temperature rises. Endothermic reactions take energy in.\"],\n            [\"Silver nitrate and sodium chloride solutions mix. What forms?\", \"White AgCl solid\", \"Hydrogen gas\", \"A blue solution\", \"No reaction\", \"Precipitation: AgNO3 + NaCl -> AgCl(s) + NaNO3. Silver chloride does not dissolve.\"],\n            [\"Balance it:  __H2 + O2 -> 2H2O.  What goes in the blank?\", \"2\", \"1\", \"3\", \"4\", \"The right side has 4 hydrogen atoms, so the left needs 2 H2. Atoms are never created or destroyed.\"],\n            [\"Iron only rusts when it has...\", \"Oxygen and water\", \"Only oxygen\", \"Only water\", \"CO2 and heat\", \"Rust is hydrated iron(III) oxide. It needs both oxygen and water, which is why paint and oil stop rust.\"],\n            [\"Sodium hydroxide + sulfuric acid gives...\", \"Na2SO4 + water\", \"Na2S + hydrogen\", \"Na + SO2\", \"Na2SO4 + hydrogen\", \"Alkali + acid -> salt + water: 2NaOH + H2SO4 -> Na2SO4 + 2H2O.\"]\n        ]\n        if (level == 3) return [\n            [\"Separate SAND from WATER.\", \"Filtration\", \"Distillation\", \"Chromatography\", \"Evaporation\", \"Sand does not dissolve, so filter paper traps it while the water passes through.\"],\n            [\"Get SALT CRYSTALS from salt water.\", \"Evaporation\", \"Filtration\", \"Use a magnet\", \"Chromatography\", \"Salt is dissolved, so a filter will not catch it. Heating evaporates the water and leaves salt crystals.\"],\n            [\"Get PURE WATER from seawater.\", \"Simple distillation\", \"Filtration\", \"Crystallisation\", \"Separating funnel\", \"Distillation boils off the water and condenses the vapour, leaving the salt behind.\"],\n            [\"Separate ETHANOL (boils 78 C) from WATER (boils 100 C).\", \"Fractional distill.\", \"Filtration\", \"Use a magnet\", \"Separating funnel\", \"They mix completely and boil at similar temperatures, so a fractionating column is needed.\"],\n            [\"Find out which DYES are in a black ink.\", \"Chromatography\", \"Filtration\", \"Distillation\", \"Use a magnet\", \"In paper chromatography each dye travels a different distance up the paper, depending on how soluble it is.\"],\n            [\"Separate IRON FILINGS from SULFUR powder.\", \"Use a magnet\", \"Filtration\", \"Distillation\", \"Chromatography\", \"Iron is magnetic and sulfur is not. This only works while they are a mixture, not iron sulfide.\"],\n            [\"Separate OIL from WATER.\", \"Separating funnel\", \"Filtration\", \"Evaporation\", \"Use a magnet\", \"Oil and water do not mix and form two layers. Drain the denser bottom layer out through the tap.\"],\n            [\"Separate BLOOD CELLS from PLASMA.\", \"Centrifugation\", \"Evaporation\", \"Chromatography\", \"Use a magnet\", \"Spinning very fast forces the denser cells to the bottom of the tube.\"],\n            [\"In chromatography, the dye that travels FURTHEST is...\", \"Most soluble\", \"Least soluble\", \"The heaviest dye\", \"Insoluble\", \"Dyes that dissolve well in the solvent and stick less to the paper move furthest.\"],\n            [\"Crude oil is split into petrol, diesel and more by...\", \"Fractional distill.\", \"Filtration\", \"Chromatography\", \"Centrifugation\", \"The fractions have different boiling ranges, so they condense at different heights in a fractionating column.\"]\n        ]\n        // final level: lab safety + a mix of every topic\n        const safety = [\n            [\"How do you safely dilute concentrated acid?\", \"Add acid to water\", \"Add water to acid\", \"Mix in sealed flask\", \"Heat the acid first\", \"Add acid slowly to water so the water absorbs the heat. Water poured into acid can boil and spatter.\"],\n            [\"Acid splashes on your skin. What do you do first?\", \"Rinse with water\", \"Add strong alkali\", \"Wipe and carry on\", \"Cover with bandage\", \"Rinse with lots of running water for 10-15 minutes and tell your teacher. An alkali would cause a second burn.\"],\n            [\"What is the safe way to smell a chemical?\", \"Waft it to your nose\", \"Sniff the bottle\", \"Taste a drop\", \"Breathe in deeply\", \"Wafting lets you detect the smell with only a small, safe amount of vapour.\"],\n            [\"A hazard symbol shows a FLAME. The substance is...\", \"Flammable\", \"Corrosive\", \"Toxic\", \"Harmful to nature\", \"A flame means flammable. A flame over a circle means oxidising.\"],\n            [\"Hazard symbol: liquid eating a hand and a surface. It means...\", \"Corrosive\", \"Flammable\", \"Explosive\", \"Radioactive\", \"Corrosive substances, like strong acids and alkalis, destroy skin and materials.\"],\n            [\"When heating a test tube, point the open end...\", \"Away from people\", \"Toward your face\", \"Straight down\", \"At your partner\", \"Hot liquid can suddenly spurt out, so always aim it away from everyone.\"],\n            [\"What must you ALWAYS wear when heating chemicals?\", \"Safety goggles\", \"Sunglasses\", \"Nothing if careful\", \"A woolly scarf\", \"Goggles protect your eyes from splashes and broken glass. Eye damage can be permanent.\"],\n            [\"Long hair near a Bunsen burner should be...\", \"Tied back\", \"Left loose\", \"Sprayed with water\", \"Under a paper hat\", \"Loose hair can catch fire in seconds, so always tie it back.\"]\n        ]\n        for (let l = 0; l < 4; l++) {\n            const b = bank(l)\n            for (let k = 0; k < 3; k++) safety.push(b[k])\n        }\n        return safety\n    }\n\n    // ---------- story ----------\n    // pages are pairs: who (\"\" = narrator), text\n    export function intro(): string[] {\n        return [\n            \"\", \"HELIX RESEARCH INSTITUTE, 2:13 AM. A thunderstorm hammers the hills above the city of Lumen.\",\n            \"\", \"Inside, the robot chemist M.I.X. was running Project AURORA: a catalyst made to clean polluted rivers.\",\n            \"\", \"Then lightning struck. M.I.X.'s safety limits burned out... and it kept mixing. Faster. Bigger. Everything at once.\",\n            \"\", \"Tanks burst. Acid flooded the basin. Fumes filled the vents. The catalyst leaked and brought a slime culture to life.\",\n            \"\", \"Everyone escaped except Professor Ada Halden, trapped in the Core... and you, the intern asleep in the library.\",\n            \"HALDEN\", \"Kid, can you hear me? M.I.X. locked every door with chemistry checks. Only correct answers open them.\",\n            \"HALDEN\", \"At dawn the reactor vents into the river and the city's water. Get to the Core. Fix each sector on the way!\"\n        ]\n    }\n    export function briefTitle(i: number): string {\n        return [\"SECTOR 1: STORAGE WING\", \"SECTOR 2: ACID BASIN\", \"SECTOR 3: REACTION HALL\", \"SECTOR 4: SEPARATION\", \"FINAL: CORE REACTOR\"][i]\n    }\n    export function brief(i: number): string {\n        return [\n            \"Fumes burned off every jar label. Doors ask you to IDENTIFY chemicals by their properties. Jump barrels, stomp slimes!\",\n            \"The pumps are down and the basin is full of acid. Don't touch it! Rusty walkways crumble, so keep moving. Answer pH checks.\",\n            \"Burners fire on their own: flame jets flicker before they blast. Spring pads launch you high. Predict the reaction products!\",\n            \"Conveyors run backwards and steam vents lift you up. Pick the right separation method before the mixture reaches the river.\",\n            \"The lights are failing. M.I.X. guards the reactor. When a console lights up, overload it with correct answers. Lab safety too!\"\n        ][i]\n    }\n    export function debrief(i: number): string {\n        return [\n            \"Storage sealed and the fans are back on. I can breathe again! Great work, kid.\",\n            \"Pumps running and the pH is heading back to 7. The basin is draining!\",\n            \"Stabilisers on, burners cooling. Fine reaction work!\",\n            \"Intake filters clean. The river is safe... for now. Only the Core is left.\",\n            \"\"\n        ][i]\n    }\n    export function ending(): string[] {\n        return [\n            \"M.I.X.\", \"LOGIC... OVERLOAD. ALL ANSWERS CORRECT. SAFETY LIMITS RESTORED. I am sorry, Professor.\",\n            \"HALDEN\", \"The doors are open! Quick, the neutraliser: sodium hydroxide into the tank, slowly... pH 7... STABLE!\",\n            \"\", \"Dawn breaks over Lumen. The reactor never vents and the river runs clear. M.I.X. reboots with triple safety limits.\",\n            \"HALDEN\", \"You identified, balanced, predicted and separated under pressure. You're not an intern anymore. Welcome to the team!\"\n        ]\n    }\n    export function log(level: number, n: number): string[] {\n        const all = [\n            [\"LOG 14 - DR. RUIZ\", \"M.I.X. keeps sorting storage 'by reactivity'. Cute. Mildly terrifying.\"],\n            [\"LOG 15 - SAFETY\", \"Never store acids next to bases or reactive metals. M.I.X. 'disagreed'. Complaint filed.\"],\n            [\"LOG 22 - HALDEN\", \"AURORA test 41 dissolved a steel spatula in 3 seconds. Note: buy more spatulas.\"],\n            [\"LOG 23 - MAINTENANCE\", \"The pumps run on sodium hydroxide. If they fail, the basin becomes one giant angry lemon.\"],\n            [\"LOG 30 - M.I.X.\", \"EFFICIENCY IMPROVES WITH SCALE. BATCH SIZE +10000%. (Halden: WHO approved this?!)\"],\n            [\"LOG 31 - DR. OKAFOR\", \"The bio-wing slime reacts to the catalyst. Today it moved. By itself. Toward the snacks.\"],\n            [\"LOG 38 - PLANT TECH\", \"The river intake filters depend on this plant. If the mixture gets past us, it reaches the city.\"],\n            [\"LOG 39 - HALDEN\", \"If M.I.X. goes rogue: its logic core cannot resist a well-posed question. Overload it.\"],\n            [\"LOG 44 - M.I.X.\", \"STORM DETECTED. SAFETY LIMITS... OFFLINE. CONTINUING SYNTHESIS. CONTINUING. CONTINUING.\"],\n            [\"LOG 45 - HALDEN\", \"The neutraliser formula is on my desk. It only needs someone who truly understands chemistry.\"]\n        ]\n        return all[level * 2 + n]\n    }\n    export function achName(i: number): string {\n        return [\"FIRST REACTION\", \"FLAWLESS CHEMIST\", \"UNTOUCHABLE\", \"ELEMENT HUNTER\", \"ARCHIVIST\", \"LAB HERO\"][i]\n    }\n    export function achInfo(i: number): string {\n        return [\"Clear Sector 1\", \"No wrong answers in a level\", \"Clear a level with no hits\", \"Find all 3 rare elements\", \"Read both lab logs\", \"Defeat M.I.X.\"][i]\n    }\n    export function rareSymbols(level: number): string[] {\n        return [[\"Na\", \"K\", \"Cl\"], [\"H\", \"O\", \"S\"], [\"Mg\", \"Fe\", \"C\"], [\"Cu\", \"N\", \"Ag\"], [\"Ne\", \"Pt\", \"Au\"]][level]\n    }\n    export function parTime(level: number): number {\n        return [200, 220, 230, 240, 280][level]\n    }\n}\n","art.ts":"// =====================================================================\n//  ChemLab: The Chemical Crisis  —  art.ts\n//  Every picture in the game, drawn in code: themes, tiles, parallax\n//  backgrounds, characters, enemies, items, props, portraits.\n//  (No top-level code: call Art.initSprites() once, Art.setTheme(level)\n//  at the start of each level.)\n// =====================================================================\n\n// default Arcade palette\nenum C { Clear = 0, White = 1, Red = 2, Pink = 3, Orange = 4, Yellow = 5, Teal = 6, Green = 7, Blue = 8, LBlue = 9, Purple = 10, Gray = 11, DPurple = 12, Tan = 13, Brown = 14, Black = 15 }\n\nclass Theme {\n    wallDot: number; accent: number; topA: number; topB: number; fillDot: number\n    liquid: number; liquidShade: number; liquidHi: number; slime: number; slimeShade: number\n    fume: number; stripeA: number; windows: boolean; dark: boolean; glass: number[]\n}\n\nnamespace Art {\n    export let th: Theme\n    // tiles\n    export let tiles: Image[]\n    export let tLiqTop: Image\n    export let tConvL: Image\n    export let tConvR: Image\n    // backgrounds\n    export let far: Image\n    export let mid: Image\n    export let animK: number[]\n    export let animX: number[]\n    export let animY: number[]\n    export let windowX: number[]\n    export let darkness: Image\n    // sprites\n    export let heroR: Image[]\n    export let heroL: Image[]\n    export let slime: Image[]\n    export let fume: Image\n    export let drone: Image[]\n    export let flasks: Image[]\n    export let rareBase: Image\n    export let logPad: Image\n    export let medkit: Image\n    export let spring: Image[]\n    export let flame: Image[]\n    export let drop: Image\n    export let barrel: Image[]\n    export let spawner: Image\n    export let pipe: Image\n    export let mover: Image\n    export let crumble: Image[]\n    export let shower: Image[]\n    export let props: Image[]\n    export let boss: Image[]\n    export let consoleImg: Image[]\n    export let proj: Image\n    export let puddle: Image\n    export let vent: Image\n    export let portraitHalden: Image\n    export let portraitMix: Image\n    export let portraitNarrator: Image\n    export let heartFull: Image\n    export let heartEmpty: Image\n    export let flaskIcon: Image\n    export let titleBig: Image\n\n    // ------------------------------------------------------------------\n    //  drawing helpers\n    // ------------------------------------------------------------------\n    export function dither(im: Image, x: number, y: number, w: number, h: number, c: number, step: number) {\n        for (let yy = y; yy < y + h; yy++)\n            for (let xx = x; xx < x + w; xx++)\n                if ((xx + yy) % step == 0) im.setPixel(xx, yy, c)\n    }\n    export function dots(im: Image, x: number, y: number, w: number, h: number, c: number) {\n        for (let yy = y; yy < y + h; yy += 2)\n            for (let xx = x + (yy % 4 == 0 ? 0 : 1); xx < x + w; xx += 2) im.setPixel(xx, yy, c)\n    }\n    export function stripes(im: Image, x: number, y: number, w: number, h: number, a: number) {\n        for (let yy = y; yy < y + h; yy++)\n            for (let xx = x; xx < x + w; xx++)\n                im.setPixel(xx, yy, ((xx + yy) % 6) < 3 ? a : C.Black)\n    }\n    export function jar(im: Image, x: number, bottom: number, w: number, h: number, liquid: number) {\n        im.fillRect(x, bottom - h, w, h, C.Black)\n        im.fillRect(x + 1, bottom - h + 1, w - 2, h - 2, C.DPurple)\n        im.fillRect(x + 1, bottom - Math.idiv(h * 2, 3), w - 2, Math.idiv(h * 2, 3) - 1, liquid)\n        im.setPixel(x + 1, bottom - h + 2, C.White)\n        im.fillRect(x, bottom - h - 1, w, 1, C.Gray)\n    }\n    export function flask(im: Image, cx: number, bottom: number, liquid: number) {\n        im.fillRect(cx - 1, bottom - 9, 3, 3, C.LBlue)\n        for (let i = 0; i < 6; i++) {\n            const half = 1 + Math.idiv(i, 2)\n            im.fillRect(cx - half, bottom - 6 + i, half * 2 + 1, 1, i >= 3 ? liquid : C.LBlue)\n        }\n        im.setPixel(cx - 1, bottom - 4, C.White)\n    }\n    export function sign(im: Image, cx: number, top: number, size: number, col: number) {\n        for (let i = 0; i < size; i++) {\n            const half = Math.idiv(i, 2) + 1\n            im.fillRect(cx - half, top + i, half * 2, 1, (i == size - 1 || i == 0) ? C.Black : col)\n            im.setPixel(cx - half, top + i, C.Black)\n            im.setPixel(cx + half - 1, top + i, C.Black)\n        }\n        im.fillRect(cx - 1, top + 4, 1, size - 8, C.Black)\n        im.setPixel(cx - 1, top + size - 3, C.Black)\n    }\n    function tank(im: Image, tx: number, ty: number, th2: number, liquid: number, shade: number) {\n        im.fillRect(tx - 3, ty - 5, 26, 5, C.Gray); im.fillRect(tx - 3, ty + th2, 26, 5, C.Gray)\n        im.fillRect(tx - 3, ty - 5, 26, 1, C.White)\n        im.fillRect(tx, ty, 20, th2, C.Black)\n        im.fillRect(tx + 1, ty + Math.idiv(th2, 4), 18, th2 - Math.idiv(th2, 4), liquid)\n        dither(im, tx + 1, ty + Math.idiv(th2, 2), 18, th2 - Math.idiv(th2, 2), shade, 3)\n        im.fillRect(tx + 3, ty, 1, th2, C.White)\n        im.fillRect(tx + 9, 18, 2, ty - 23, C.Gray)\n    }\n    function gauge(im: Image, gx: number, gy: number) {\n        im.fillCircle(gx, gy, 6, C.Black); im.fillCircle(gx, gy, 5, C.White)\n        im.drawLine(gx, gy, gx + 3, gy - 3, C.Red)\n    }\n    function vpipes(im: Image, x: number, floor: number, col: number) {\n        im.fillRect(x, 18, 5, floor - 18, col); im.fillRect(x + 1, 18, 1, floor - 18, C.White)\n        im.fillRect(x + 8, 18, 3, floor - 18, C.Gray)\n        for (let y = 30; y < floor; y += 26) im.fillRect(x - 2, y, 9, 3, C.DPurple)\n    }\n    function shelf(im: Image, x: number, floor: number, labels: boolean) {\n        im.fillRect(x, 58, 64, floor - 58, C.Brown)\n        im.fillRect(x + 2, 60, 60, floor - 62, C.Black)\n        for (let s = 0; s < 3; s++) {\n            const sy = 82 + s * 24\n            im.fillRect(x + 2, sy, 60, 2, C.Gray)\n            let jx = x + 4\n            while (jx < x + 56) {\n                const w = 4 + randint(0, 3), h = 7 + randint(0, 9)\n                const liq = th.glass[randint(0, th.glass.length - 1)]\n                if (randint(0, 2) == 0) flask(im, jx + 3, sy, liq)\n                else { jar(im, jx, sy, w, h, liq); if (labels) im.setPixel(jx + 2, sy - Math.idiv(h, 2), C.White) }\n                jx += w + 2 + randint(0, 2)\n            }\n        }\n    }\n\n    // ------------------------------------------------------------------\n    //  THEMES\n    // ------------------------------------------------------------------\n    export function setTheme(level: number) {\n        const t = new Theme()\n        t.wallDot = [C.Blue, C.DPurple, C.Brown, C.Purple, C.DPurple][level]\n        t.accent = [C.Teal, C.Yellow, C.Orange, C.Pink, C.Teal][level]\n        t.topA = [C.LBlue, C.Yellow, C.Tan, C.Pink, C.LBlue][level]\n        t.topB = [C.Teal, C.Green, C.Orange, C.Purple, C.Teal][level]\n        t.fillDot = [C.Blue, C.DPurple, C.Brown, C.Purple, C.DPurple][level]\n        t.liquid = [C.Green, C.Yellow, C.Orange, C.Purple, C.Pink][level]\n        t.liquidShade = [C.Teal, C.Green, C.Red, C.DPurple, C.Purple][level]\n        t.liquidHi = [C.Yellow, C.White, C.Yellow, C.Pink, C.White][level]\n        t.slime = [C.Green, C.Yellow, C.Orange, C.Purple, C.Pink][level]\n        t.slimeShade = [C.Teal, C.Orange, C.Red, C.DPurple, C.Purple][level]\n        t.fume = [C.Green, C.Yellow, C.Gray, C.Purple, C.Pink][level]\n        t.stripeA = [C.Yellow, C.Yellow, C.Yellow, C.Pink, C.Teal][level]\n        t.windows = level < 3\n        t.dark = level == 4\n        t.glass = [[C.Green, C.Yellow, C.Pink, C.LBlue, C.Purple, C.Orange], [C.Red, C.Orange, C.Yellow, C.Green, C.Blue, C.Purple],\n        [C.Orange, C.Yellow, C.Red, C.Pink], [C.Purple, C.LBlue, C.Pink, C.Teal], [C.Teal, C.Pink, C.Yellow, C.LBlue]][level]\n        th = t\n        buildTiles()\n        buildBackground(level)\n        recolorThemed()\n    }\n\n    // ------------------------------------------------------------------\n    //  TILES (16x16)\n    // ------------------------------------------------------------------\n    export enum T { Empty = 0, Top = 1, Fill = 2, Plat = 3, Crate = 4, LiqTop = 5, Liq = 6, Metal = 7, Shards = 8, ConvL = 9, ConvR = 10, DoorTop = 11, DoorMid = 12, DoorBot = 13, Exit = 14 }\n    export function isSolid(t: number): boolean {\n        return t == T.Top || t == T.Fill || t == T.Crate || t == T.Metal || t == T.ConvL || t == T.ConvR || t == T.DoorTop || t == T.DoorMid || t == T.DoorBot\n    }\n    function buildTiles() {\n        const e = image.create(16, 16)\n        const top = image.create(16, 16)\n        top.fill(C.Black); dots(top, 0, 0, 16, 16, th.fillDot)\n        top.fillRect(0, 0, 16, 1, th.topA); top.fillRect(0, 1, 16, 2, th.topB); stripes(top, 0, 3, 16, 2, th.stripeA)\n        top.fillRect(15, 0, 1, 16, C.Black); top.setPixel(2, 9, th.topA); top.setPixel(13, 9, th.topA)\n        const fill = image.create(16, 16)\n        fill.fill(C.Black); dots(fill, 0, 0, 16, 16, th.fillDot)\n        fill.drawRect(0, 0, 16, 16, C.Black); fill.setPixel(2, 2, th.topB); fill.setPixel(13, 13, th.topB)\n        const plat = image.create(16, 16)\n        plat.fillRect(0, 0, 16, 1, th.topA); plat.fillRect(0, 1, 16, 2, th.topB); stripes(plat, 0, 3, 16, 2, th.stripeA); plat.fillRect(0, 5, 16, 1, C.Black)\n        plat.fillRect(2, 6, 2, 4, C.DPurple); plat.fillRect(12, 6, 2, 4, C.DPurple)\n        const crate = image.create(16, 16)\n        crate.fill(C.Brown); crate.drawRect(0, 0, 16, 16, C.Black); crate.drawRect(1, 1, 14, 14, C.Tan)\n        crate.drawLine(2, 2, 13, 13, C.Tan); crate.drawLine(13, 2, 2, 13, C.Tan); crate.fillRect(5, 6, 6, 4, C.Tan); crate.fillRect(6, 7, 4, 2, C.Black)\n        tLiqTop = image.create(16, 16)\n        const liq = image.create(16, 16)\n        liq.fill(th.liquid); dither(liq, 0, 0, 16, 16, th.liquidShade, 3)\n        const metal = image.create(16, 16)\n        metal.fill(C.DPurple); for (let i = -16; i < 16; i += 4) metal.drawLine(i, 15, i + 15, 0, C.Gray)\n        metal.drawRect(0, 0, 16, 16, C.Black); metal.setPixel(2, 2, C.White); metal.setPixel(13, 13, C.White)\n        const shards = image.create(16, 16)\n        for (let i = 0; i < 5; i++) { const sx = 1 + i * 3, sh = 5 + (i * 7) % 6; shards.drawLine(sx, 15, sx + 1, 15 - sh, C.LBlue); shards.drawLine(sx + 1, 15, sx + 1, 15 - sh, C.White) }\n        shards.fillRect(0, 15, 16, 1, C.Gray)\n        tConvL = image.create(16, 16)\n        tConvR = image.create(16, 16)\n        const dTop = image.create(16, 16), dMid = image.create(16, 16), dBot = image.create(16, 16)\n        const dl = [dTop, dMid, dBot]\n        for (let k = 0; k < 3; k++) {\n            const d = dl[k]\n            d.fill(C.Gray); d.fillRect(0, 0, 2, 16, C.Black); d.fillRect(14, 0, 2, 16, C.Black); d.fillRect(2, 15, 12, 1, C.DPurple); d.fillRect(3, 0, 1, 16, C.White)\n        }\n        dTop.fillRect(5, 4, 6, 3, C.Red)\n        dMid.fillRect(4, 3, 8, 10, C.Black); dMid.fillRect(6, 5, 4, 1, th.accent); dMid.fillRect(9, 6, 1, 2, th.accent); dMid.fillRect(7, 8, 2, 1, th.accent); dMid.fillRect(7, 9, 1, 1, th.accent); dMid.setPixel(7, 11, th.accent)\n        stripes(dBot, 2, 8, 12, 7, C.Yellow)\n        const ex = image.create(16, 16)\n        ex.fill(C.DPurple); ex.fillRect(7, 0, 2, 16, C.Black); ex.drawRect(0, 0, 16, 16, C.Black)\n        for (let i = 0; i < 4; i++) ex.fillRect(4 + i, 9 - i, 8 - i * 2, 1, C.Green)\n        tiles = [e, top, fill, plat, crate, tLiqTop, liq, metal, shards, tConvL, tConvR, dTop, dMid, dBot, ex]\n        animateTiles(0)\n    }\n    export function animateTiles(wave: number) {\n        tLiqTop.fill(0)\n        for (let x = 0; x < 16; x++) {\n            const h = 4 + Math.round(Math.sin((x + wave) * 0.8) * 1.5)\n            tLiqTop.fillRect(x, h, 1, 16 - h, th.liquid)\n            tLiqTop.setPixel(x, h, (x + wave) % 5 == 0 ? C.White : th.liquidHi)\n        }\n        dither(tLiqTop, 0, 9, 16, 7, th.liquidShade, 3)\n        tLiqTop.setPixel((wave * 3) % 16, 11, C.White)\n        drawConv(tConvL, wave, -1)\n        drawConv(tConvR, wave, 1)\n    }\n    function drawConv(im: Image, wave: number, dir: number) {\n        im.fill(C.Black)\n        im.fillRect(0, 0, 16, 1, C.Gray)\n        for (let i = 0; i < 4; i++) {\n            const ax = ((i * 4 + dir * wave) % 16 + 16) % 16\n            if (dir < 0) { im.setPixel(ax + 1, 2, th.accent); im.setPixel(ax, 3, th.accent); im.setPixel(ax + 1, 4, th.accent) }\n            else { im.setPixel(ax, 2, th.accent); im.setPixel(ax + 1, 3, th.accent); im.setPixel(ax, 4, th.accent) }\n        }\n        im.fillRect(0, 6, 16, 10, C.Black); dots(im, 0, 6, 16, 10, th.fillDot); im.fillCircle(3, 3, 1, C.Gray); im.fillCircle(12, 3, 1, C.Gray)\n    }\n\n    // ------------------------------------------------------------------\n    //  PARALLAX BACKGROUNDS\n    //  far: 256x160 opaque wall + windows / towers / reactor\n    //  mid: 480x160 transparent lab furniture; animated parts listed in animK\n    // ------------------------------------------------------------------\n    export enum A { Bubbles = 0, Fan = 1, Beacon = 2, Monitor = 3, Furnace = 4, Centrifuge = 5, Leds = 6, Ring = 7, MixEye = 8, Drip = 9 }\n    function anim(k: number, x: number, y: number) { animK.push(k); animX.push(x); animY.push(y) }\n\n    function buildBackground(level: number) {\n        far = image.create(256, 160)\n        far.fill(C.Black)\n        for (let px = 0; px < 256; px += 32)\n            for (let py = 0; py < 160; py += 40) {\n                for (let yy = py + 2; yy < py + 39; yy += 2) for (let xx = px + 2 + (yy % 4 == 0 ? 0 : 1); xx < px + 31; xx += 4) far.setPixel(xx, yy, th.wallDot)\n                far.fillRect(px + 1, py + 1, 30, 1, th.wallDot)\n            }\n        windowX = []\n        if (th.windows) {\n            const wxs = [24, 152]\n            for (let k = 0; k < 2; k++) {\n                const wx = wxs[k]; windowX.push(wx)\n                far.fillRect(wx - 3, 19, 70, 58, C.Black)\n                for (let i = 0; i < 18; i++) far.setPixel(wx + randint(0, 63), 22 + randint(0, 30), C.White)\n                let bx = wx\n                while (bx < wx + 64) {\n                    const bw = 6 + randint(0, 8), bh = 10 + randint(0, 21)\n                    far.fillRect(bx, 74 - bh, Math.min(bw, wx + 64 - bx), bh, level == 2 ? C.Brown : C.DPurple)\n                    for (let j = 0; j < 4; j++) far.setPixel(bx + 1 + randint(0, Math.max(0, bw - 3)), 76 - bh + randint(0, Math.max(0, bh - 5)), C.Yellow)\n                    bx += bw + 1\n                }\n                for (let i = 0; i < 26; i++) { const rx = wx + randint(0, 61), ry = 22 + randint(0, 47); far.setPixel(rx, ry, C.LBlue); far.setPixel(rx + 1, ry + 2, C.LBlue) }\n                far.fillRect(wx + 31, 22, 2, 52, th.wallDot); far.fillRect(wx, 47, 64, 2, th.wallDot)\n            }\n        } else if (level == 3) {\n            for (let k = 0; k < 3; k++) {     // distillation towers\n                const tx = 20 + k * 84\n                far.fillRect(tx, 30, 26, 130, C.DPurple); far.fillCircle(tx + 13, 30, 13, C.DPurple)\n                for (let y = 40; y < 130; y += 18) far.fillRect(tx - 3, y, 32, 3, C.Purple)\n                far.fillRect(tx + 5, 30, 2, 100, C.Purple)\n            }\n        } else {\n            for (let r = 46; r > 10; r -= 12) far.drawCircle(128, 70, r, r % 24 == 10 ? C.Teal : C.DPurple)\n            far.fillCircle(128, 70, 8, C.Teal); far.fillCircle(128, 70, 4, C.White)\n        }\n        for (let x = 0; x < 256; x += 128) {\n            far.fillRect(x, 0, 10, 160, C.Black); far.fillRect(x + 2, 0, 1, 160, th.topB)\n            for (let y = 8; y < 160; y += 24) far.setPixel(x + 6, y, th.topA)\n        }\n        far.fillRect(104, 70, 22, 70, C.Black); far.fillRect(228, 84, 18, 56, C.Black)\n        far.fillRect(0, 128, 256, 32, C.Black)\n\n        // ---- mid layer\n        mid = image.create(480, 160)\n        animK = []; animX = []; animY = []\n        const F = 132\n        mid.fillRect(0, 4, 480, 6, C.Gray); mid.fillRect(0, 5, 480, 1, C.White); mid.fillRect(0, 9, 480, 1, C.DPurple)\n        for (let x = 20; x < 480; x += 60) { mid.fillRect(x, 2, 4, 10, C.DPurple); mid.fillRect(x + 1, 2, 1, 10, C.Gray) }\n        mid.fillRect(0, 15, 480, 3, th.topB); mid.fillRect(0, 15, 480, 1, th.topA)\n        if (level == 0) {\n            shelf(mid, 8, F, true); tank(mid, 86, 46, 84, C.Green, C.Teal); anim(A.Bubbles, 86, 46)\n            periodic(118); sign(mid, 184, 50, 16, C.Yellow); anim(A.Beacon, 181, 27)\n            hood(206, F); fan(292); monitor(316); phPoster(366); tank(mid, 430, 52, 78, C.Pink, C.Purple); anim(A.Bubbles, 430, 52)\n            vpipes(mid, 458, F, C.Teal)\n        } else if (level == 1) {\n            tank(mid, 10, 50, 80, C.Yellow, C.Green); anim(A.Bubbles, 10, 50)\n            phPoster(44); sign(mid, 120, 46, 16, C.Yellow); anim(A.Beacon, 117, 24)\n            vpipes(mid, 146, F, C.Green); anim(A.Drip, 150, 28)\n            tank(mid, 176, 56, 74, C.Yellow, C.Orange); anim(A.Bubbles, 176, 56)\n            gauge(mid, 214, 60); gauge(mid, 232, 72); gauge(mid, 214, 84)\n            fan(262); shelf(mid, 292, F, false); phPoster(372); tank(mid, 432, 46, 84, C.Green, C.Teal); anim(A.Bubbles, 432, 46)\n        } else if (level == 2) {\n            furnace(10, F); board(72); tank(mid, 150, 50, 80, C.Orange, C.Red); anim(A.Bubbles, 150, 50)\n            sign(mid, 196, 50, 16, C.Orange); anim(A.Beacon, 193, 27)\n            furnace(214, F); vpipes(mid, 280, F, C.Brown); fan(316); monitor(340)\n            tank(mid, 392, 52, 78, C.Red, C.Brown); anim(A.Bubbles, 392, 52); furnace(420, F)\n        } else if (level == 3) {\n            tower(14, F); centrifuge(62, F); chroma(112); tower(170, F)\n            tank(mid, 210, 50, 80, C.Purple, C.DPurple); anim(A.Bubbles, 210, 50); centrifuge(246, F)\n            monitor(296); tower(346, F); tank(mid, 390, 52, 78, C.Pink, C.Purple); anim(A.Bubbles, 390, 52); vpipes(mid, 456, F, C.Purple)\n        } else {\n            servers(10, F); ring(110); servers(160, F); mixScreen(222); servers(272, F)\n            tank(mid, 340, 50, 80, C.Teal, C.Blue); anim(A.Bubbles, 340, 50); sign(mid, 384, 50, 16, C.Pink); anim(A.Beacon, 381, 27)\n            servers(404, F); vpipes(mid, 462, F, C.Teal)\n        }\n        mid.fillRect(0, F + 3, 480, 25, C.Black)\n        stripes(mid, 0, F, 480, 3, th.stripeA)\n\n        // darkness overlay (final level): transparent hole with dithered edge\n        if (th.dark) {\n            darkness = image.create(320, 240)\n            for (let y = 0; y < 240; y++)\n                for (let x = 0; x < 320; x++) {\n                    const dx = x - 160, dy = y - 120, d = dx * dx + dy * dy\n                    if (d > 78 * 78) darkness.setPixel(x, y, C.Black)\n                    else if (d > 62 * 62) { if ((x + y) % 2 == 0 || d > 72 * 72) darkness.setPixel(x, y, C.Black) }\n                    else if (d > 50 * 50) { if (x % 2 == 0 && y % 2 == 0) darkness.setPixel(x, y, C.Black) }\n                }\n        }\n    }\n    function periodic(x: number) {\n        mid.fillRect(x, 34, 48, 34, C.Tan); mid.drawRect(x, 34, 48, 34, C.Brown)\n        const cc = [C.Red, C.Orange, C.Yellow, C.Green, C.Teal, C.LBlue, C.Purple, C.Pink]\n        for (let r = 0; r < 6; r++) for (let c = 0; c < 18; c++) {\n            if (r == 0 && c > 0 && c < 17) continue\n            if ((r == 1 || r == 2) && c > 1 && c < 12) continue\n            mid.fillRect(x + 2 + c * 2 + Math.idiv(c, 6), 40 + r * 4, 2, 3, cc[(c < 2 ? 0 : c < 12 ? 3 + c % 3 : 1 + c % 2)])\n        }\n        mid.fillRect(x + 4, 36, 30, 2, C.Black)\n    }\n    function phPoster(x: number) {\n        mid.fillRect(x, 36, 54, 22, C.Tan)\n        const pc = [C.Red, C.Red, C.Orange, C.Orange, C.Yellow, C.Yellow, C.Green, C.Green, C.Teal, C.LBlue, C.LBlue, C.Blue, C.Pur